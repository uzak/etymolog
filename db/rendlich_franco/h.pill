// SRC Comparative etymological Dictionary of classical Indo-European languages
// LANG en

ie:h [shift of position] [pressure] [push]

ie:aMh [to start (a) a compression (h)] = to tigthen, to compress, to be tight, to suffocate

ie:aMh -> sa:aMh/aMhati = to press together, to strangle
sa:aMh -> sa:aMhati = anxiety, distress
sa:aMh -> sa:amhu = narrow, anxiety
sa:aMh -> sa:ahi [demon vRtra] = snake
ie:aMh -> gr:AgkhO = to press tight, to strangle
gr:AgkhO -> gr:Akhos = pain, distress
gr:AgkhO -> gr:agkhOne = strangling, suffocation,anguish
gr:agkhOne -> sk:agOnia
gr:AgkhO -> gr:Ekhis = viper, adder
gr:AgkhO -> gr:Ophis = serpent, snake
ie:aMh -> lat:ango/.ere = to press tingly, to strangle
lat:ango -> lat:angor/.oris = anguish, suffocation
lat:ango -> lat:angina/.ae = quinsy
lat:ango -> lat:angustus = narrow
lat:ango -> lat:anxious = anxious

ie:ah [to start (a) pressure (h)] [to make a sound with the voice] [the meaning, in referfence to the emission of the voice, was "to express"] = to express, to say
ie:ah -> sa:ah = to say, to speak, to call
ie:ah -> sa:aham [I speak] [I say my name] [originally: "to squeeze out the voice", "I am he who speaks", "I say", "I am called", "it is me"] = I
sa:aham -> sa:niraham [that removes (nir) the self (aham)]

ie:ah -> gr:ekhEO = to sound, to ring
gr:ekhEO -> gr:egO = I
gr:ekhEO -> gr:EkhE = sound, noice
gr:ekhEO -> gr:EkheIon = drum
gr:ekhEO -> gr:Ekhos = sound
gr:ekhEO -> gr:EkhO [reverberated sound] = echo

ie:ah -> lat:axo/.are = to name
ie:ah -> lat:agio = to say yes, to affirm, to say
lat:agio -> lat:adagium = proverb, sentence
lat:agio -> lat:prodigium [issuance of a divine voice] = prophetic word, prodigy, portent
lat:agio -> lat:aius [name of a roman god] = divine voice
lat:agio -> lat:ego [I am he who speaks] [I speak] = I
lat:ego ~ lat:nego [I say no]

ie:Uh1 [to press (h) with force (U)] = to express aloud, to pay attention, to pray, to make a vow
ie:Uh1 -> sa:Uh/ohate = to observe, to mark, to note
sa:Uh -> sa:Uha [the act of comprehending] = consideration
ie:Uh1 ~ sk:uhkaT
ie:Uh1 -> gr:eUkhomai = to pray, to pay one's vows
gr:eUkhomai -> gr:eUkhos = vow
gr:eUkhomai -> gr:eukhE = prayer, vow
ie:Uh1 -> lat:voveo/.ere = to promise
lat:voveo ->  lat:votum = to make a vow, offering made to a god, vow

ie:Uh2 [to move (h) with force (U)] = to remove
ie:Uh2 -> sa:Uh/Uhati = to push, to move, to remove
ie:Uh2 ~ sk:uhnUT
sa:Uh -> sa:Uhana = transposition, change, modification
sa:Uh -> sa:oha = vehicle
ie:Uh2 -> gr:okhEO = to bear, to carried
gr:okhEO -> gr:OkhEma = carriage, chariot
gr:okhEO -> gr:Okhos [that which holds] = chariot

ie:had [to squeeze out (h) food (ad)] [action aimed at expelling (h) the remains of digested food (anna)] = to defecate
ie:had -> sa:had/hadati = to evaucate, to discharge
sa:had -> sa:hanna = evacuated
sa:had -> sa:upahadana [the act of discharging excrement upon]
ie:had -> gr:khEzO = to ease onself
gr:khEzO -> gr:khEsma = excrement
ie:had -> lat:caco/.are [Lating, already having cad of cado in its vocabulary, with the meaning "to fall", formed the verb caco/.are replacing d with a c] = to voidone's excrement

ie:had ~ sk:hAdaT

ie:han [to remove (h) breath (an)] = to strike, to kill
ie:han -> sa:han/hanti = to strike, to beat, to slay, to kill
ie:han -> sa:hiMs/hiMsati = to injure, to harm, to kill, to slay
sa:hiMs -> sa:hiMsA = hostile act
sa:han -> sa:hata = struck, killed
sa:hata -> sk:hAtaT
sa:han -> sa:hatha = blow, stroke
sa:han -> sa:hanu [that which destroys] = death
sa:han -> sa:ghana [shaped like a hammer] = striker, killer
ie:han -> sk:haniT

ie:han -> gr:kaInO = to kill, to slay
ie:han -> gr:thAnatOO = to put to death
gr:thAnatOO -> gr:thAnataos = death
gr:thAnatOO -> gr:thnEtos = mortal
ie:han -> gr:phOnos = murder, homicide

ie:han -> lat:fendo/.ere = to strike, to knock against
lat:fendo -> lat:offendo/.ere = to stricke, to knock
lat:fendo -> lat:defendo/.ere = to repel, to defend, to protect
lat:defendo -> lat:defensor/.oris [one who wards off] = protector

ie:hanu [gives impusle (h) to breath (an)] = cheek
ie:hanu -> sa:hanu = jaw, cheek
sa:hanu -> sa:hanumat [having (large) jaws] [leader of mercenary army of creatures akin to monkeys]

ie:hanu -> gr:gEnys = jaw, jawbone, cheek
ie:hanu -> lat:gena/.ae = cheek

ie:har [to be taken (hR) (by enchanement)] [to be transported (R (mentally))] = to desire, to be delighted, to be in a state of grace
ie:har -> sa:hary/haryati/haryate = to like, to delight in, to be fond of, to long for
sa:har -> sa:haryat = eager, willing, glad
sa:har -> sa:cAru = beloved
sa:har -> sa:cArumat = lovable
sa:cAru ~ sk:CarovaT

ie:har -> gr:khaIrO = to rejoice, to be glad, to be pleased
gr:khaIrO -> gr:kharA = joy, pleasure
gr:khaIrO -> gr:khAris = favour, grace
gr:khAris -> gr:khArisma = grace, free gift
gr:khaIrO -> gr:khArma = joy
gr:khaIrO -> gr:eUkharis = pleasing, agreeable
gr:eUkharis -> gr:eukharistEO = to be thankful, to return thanks
gr:eUkharis -> gr:eukharistIa = thankfulness, gratitude, giving of thanks, the holy Eucharist
ie:har -> lat:hortor/.ari = to exhort, to incite, to encourage
ie:har -> lat:charis = grace
lat:charis -> lat:charisma = divine grace, gift
lat:charis -> lat:carus = dear, beloved
lat:charis -> lat:caritas = affection, love, charity

ie:haMsa [that which escapes (ha)] = goose
ie:haMsa -> sa:haMsa = goose
ie:haMsa -> gr:khEn = goose
ie:haMsa -> lat:hanser/.eri = goose

ie:hA [effect of the action (A) of moving (h)] = to move forward, to abandon, to leave
ie:hA -> sa:hA/jahAti = to leave, to abandon, to quit
ie:hA -> sa:hA/jihIte [to start or spring forward]
sa:hA -> sa:hala = plough
sa:hA -> sa:hAlika = ploughman, agriculutrist
sa:hA -> sa:hIna = left, abandoned, forsaken
sa:hIna ~ sk:hynUT
sa:hA -> sa:hAna [the actd of abandoning] = escaping

ie:hi [to displace (h) with continous motion (i)] = to set in motion, to push, to incite, to unload
ie:hi ~ ie:hay ~ ie:hA
ie:hi -> sa:hi/hinoti = to send forth, to impel, to set in motion, to ruge on
ie:hi -> sa:haya [that is urged on] = horse
sa:haya -> sk:hijA
ie:hi -> sa:hita = direction
ie:hi -> sa:hitvan = speedy, swift
ie:hi -> sa:hinva = inciter
ie:hi -> sa:heti [weapon that is thrown]
ie:hi -> sa:hetu = impulse, cause, reason
ie:hi -> sa:hyas [that is (as) pushed away (hi)] = yesterday
ie:hi -> gr:khthEs = yesterday
ie:hi -> lat:heri = yesterday

ie:hima [that pushes to flee (hi)] [cold, snow, winter and storm were events that would push men to mov away from their place of abode to spend their winter elsewhere] = cold, winter
ie:hima [Vopaveda, who lived around 13th century, also attributed the meaning of "to be molested or disturbed" to the root hay. This could also represent the feeling of ear that cold and winter storms generated in the hearts of ancient Indo-Europeans]
ie:hima -> sa:hima = cold, frost, cold season, winter
ie:hima -> sa:zima
ie:hima -> gr:kheIma = winter, cold, frost
ie:hima -> gr:khiOn = snow
ie:hima -> lat:hiems/.emis = winter, storm, stormy weather
lat:hiems -> lat:hiemo/.are = to winter, to spend the winter

ie:hID [what pushed away or what moves away (hi)] = aversion
ie:hID -> sa:hID/hIDati = to make angry, to vex, to offend
sa:hID -> sa:hIDa = instigator, stimulator
sa:hID -> sa:heDa = anger, passion, hatred

ie:hu [to displace (h) with force (u)] [to pour libations to the gods] [to pour in the fire] = to burn, to sacrifice
ie:hu -> sa:hu/juhoti = to sacrifice, to ffer an oblation to, to worship or honor with
sa:hu -> sa:hotR = sacrificer
sa:hu -> sa:homa [oblation with fire to the gods]
sa:hu -> sa:hava [burnt offering] = oblation
sa:hu -> sa:havis [oblation with fire]
sa:hu -> sa:huta [offered in fire] = sacrificed
sa:hu -> sa:AhavanIya [sacrificial fire prepared for receiving oblations]

ie:hu -> gr:osiOO = to make holy, to purify
gr:osiOO -> gr:osIa = divine law, divine rites, things of ordinance
ie:hu -> gr:kaIO = to burn, to kindle, to set on fire
gr:kaIO -> gr:kautEr = burner
gr:kaIO -> gr:kaUsos = heat, vever
gr:kaIO -> gr:Oloskaystos {Olos+kaystos} [completel burned] = holocaust
ie:hu -> gr:khEO = to pour, to offer drinks
gr:khEO -> gr:khoaI [various offering to the dead] [offerings of milk, honey, water or wine]
gr:khEO -> gr:khymOs [that which is poured or flows] = juice, flavor, flud
gr:khEO -> gr:khYsis = liquefaction, melting
gr:khEO -> gr:khymeIa [fusion, transmutation of metals] = chemistry
gr:khymeIa -> sk:chEmia
gr:khEO -> gr:diakhEO = diffusion
gr:khEO -> gr:khYtra = earthen pot
gr:khEO -> gr:khoUs = jug, pitcher, poring of earth, mud
ie:hu -> lat:fundo/.ere [n is nasal] = to pour, to pour out, to spread
lat:fundo -> lat:fusus -> spread out
lat:fundo -> lat:futis [in which one pours] = vase
lat:fundo -> lat:fundus [base of the vesel in which it is poured] = bottom
lat:fundus -> sk:fundovanY, sk:fundament
lat:fundus -> lat:profundus [top to the bottom] = profound
ie:hu -> lat:fusio/.ionis = fusion
lat:fusio -> sk:fUzia
lat:fusio -> lat:confundo/.ere = to confuse

ie:hU [to squeeze (h) with force (U)] [to cause the voice to come out] = to call, to invoke the gods
ie:hU -> sa:hU = calling, invoking
sa:hU -> sa:hava = invocation, call
sa:hU -> sa:hUta [puru hUta "highly invoked", is an epithet for the god Indra] = called, invited
sa:hU -> sa:hotrA = call, invocation

ie:hU -> gr:eUkhomai = to pray, to pay one's vows, to vow loudly
gr:eUkhomai -> gr:eukhE = prayer, vow
ie:hU -> gr:khaInO = to open the mouth
gr:khaInO -> gr:khAnos = mouth

ie:hvA [spreads out (vA) by means of presure (h)] [to emit the voice] = to call, to invoke
ie:hvA ~ ie:hU, ie:hve

ie:hvA -> sa:hve/hvayati = to call, to invoke
sa:hve ~ sk:chvAliT
ie:hvA -> gr:goAO = to week, to weep for, to mourn

ie:hR1 [to reach (R) in order to displace (h)] = to bear, to take away, yellow, reddish brown
ie:hR1 = ie:har
ie:hR1 [color of herbs and vegetables that got "taken" and "taken away" since they were edibles] [connected to ie:bhR, but will eventually be absorbed by ie:hR "to take" or "to bear"]

ie:hR1 -> sa:hari = yellow, pale green, reddish brown
ie:hR1 ~ sk:hermanCek
sa:hari -> sa:hariman [yellowness - disease] = yellow, yellowness
sa:hari -> sa:harita = yellowish, pale red, green
sa:hari -> sa:hariNa = fawn color, deer

ie:hR1 -> gr:khlOE = young verdure, foliage, leaves
gr:khlOE -> gr:khlOos = pale green
gr:khlOE -> gr:khlOrOs = green, yellow, pale green, light green
gr:khlOrOs -> sk:chlOr
gr:khlOE -> gr:khrysOs = gold
gr:khrysOs ~ sk:chryzantEma
gr:khlOE -> gr:kirrOs = yellow orange
ie:hR1 -> lat:helvus = yellow
ie:hR1 -> lat:flavus = golden yellow
ie:hR1 -> lat:fulvus = tawny, yellowish brown

ie:hR2 = ie:har, ie:hra
ie:hR2 [to reach (R) in order to displace (h)] = to take, to seize, to take away, to make one's own, to utilize
ie:hR2 ~ ie:bhR, ie:phR
ie:hR2 [Greek extends the semantic field to reach and posses coveted goods, and to enjoy their use. Moreover, since the mystery of life hat its origin in the female womb, it is to the oracle of DelphYs, the (cosmic) uterus, that the Greeks ask for a prophecy on their own fate]

ie:hR2 -> sa:hR/harati = to take, to bear, to carry
sa:hR -> sa:hara = bearing, taking
sa:hR -> sa:hRta = taken, taken away
sa:hRta ~ sk:hrtan
sa:hR -> sa:haraka = taker
sa:hR -> sa:harika = thief
sa:hR -> sa:hAra = carrying away, stealing, removal
sa:hR -> sa:hiraNya [that comes (hira) from the waters (n) in which one moves (ya)] = gold
sa:hR -> sa:hiraNyagarbha [the germ (garbha) borne (hira) by the waters (n) in which one moves (ya)]
sa:hR -> sa:hras/hrasati = to become short or small, to be diminished or lessened
sa:hras ~ sk:hrASok
sa:hras -> sa:hrasva = short, small, low, insignificant

ie:hR2 -> gr:kheirOO = to take in hand, to handle, to master, to subdue
gr:kheirOO -> gr:kheIr [insofar as it "takes", "seizes" or "bears"] = hand, deed, act
gr:kheirOO -> gr:khernEs = poor person
gr:kheirOO -> gr:kherIs = glove
gr:kheirOO -> gr:kheirourgOs [works with his hands] = surgeon
gr:kheirourgOs -> sk:chirurg
gr:kheirOO -> gr:dyskherEs [to be discontented, unpleasant or distressing]
gr:kheirOO -> gr:khEra [having lost a husband] [he who has has a relative taken away] = widow
gr:kheirOO -> gr:khrEma [things to possess] = goods, money, business
gr:kheirOO -> gr:khrEsmOs [answer of an oracle] = oracle
gr:kheirOO -> gr:khrEstes [one who gives oracles] [he who announces the divine will] [also "debtor", insofar as one "takes" money as a loan] = prophet
gr:kheirOO -> gr:khorOs [circling dance - since Greek dancers took each other by the hand, this originates in the semantic field of gr:kheIr "hand"] [choral dance] [place for dancing]
gr:khorOs -> sk:chOr

ie:hR2 -> lat:gero/.ere = to carry, to bear
ie:hR2 -> lat:gesto/.are = to carry, to bear about
lat:gesto ~ sk:gesto
lat:gero -> lat:gestus [in the sense of "to carry onself", "to behave"] = posture, gesture
lat:gero -> lat:heres/.edis [having lost a relative] = heir
ie:hR2  -> lat:arpio/.are = to seize, to abduct
lat:arpio -> lat:rapina/.ae = robbery, theft
gr:khorOs -> lat:chorus [dance in a circle] [choral dance] = chorus

ie:hRd [what bears (hR) the energy of light (d)] = heart
ie:hRd -> sk:hruD

ie:hRd -> sa:hRd [in Sanksrit, the heart is considered to be the home of feelings and emotions as well as thought and intellect] = heart, soul, mind
ie:hRd -> sa:suhRd = goodhearted
ie:hRd -> sa:durhRd [bad hearted] = enemy

ie:hRd -> gr:kardIa = heart
ie:hRd -> lat:cor/cordis = heart

ie:hRS [to move (h) upward (R)] [S is an enlargement] = to be exicted, to exult
ie:hRS -> sa:hRS/harSate = to be exited, to exult
ie:hRS ~ sk:haraSiT
sa:hRS -> sa:hRSi = joy, satisfaction
sa:hRS -> sa:hRSTi = delight, rapture
sa:hRS -> sa:harSa = joy, sexual erection
sa:hRS -> sa:harSana [causing one's hair to stand erect] [thrilling with joy] = sexual excitement

ie:hRS -> lat:horreo/.ere = to bristle
lat:horreo -> lat:horribilis = horrible
lat:horreo -> lat:horror/.oris = dread, fright
lat:horror -> sk:horor
lat:horreo -> lat:hirsutus [covered with hair]
lat:horreo -> lat:hirtus = hairy, rough
lat:hirtus ~ de:Hirte

ie:hnu [to move (h) to the bottom of the sea (nu)] = to hide
ie:hnu -> sa:hnu/hnute = to hide from
sa:hnu -> sa:hnuta = taken away
sa:hnu -> sa:nihnu/nihnavate = to deny, to hide

ie:hrAd [one moves (h) in order to communicate (rA)] = to make a sound, to resound
ie:hrAd -> sa:hrAd/hrAdate = to sound, to make a noise
sa:hrAd -> sa:hrAda = sound, noise, roar
ie:hrAd -> gr:phrAzO = to tell, to declare, to pronounce
gr:phrAzO -> gr:phrAsis [exposition of facts] = language, diction
gr:phrAsis -> gr:metaphrastEs {meta+prhastEs} = translator
gr:phrAsis -> lat:phrasis = diction

ie:hval {h+val} [turns (val) by means of a shifting (h)]
ie:hval -> sa:hval/hvalati [to go crookedly or astray] [to go wrongly or deviously]
sa:hval -> sa:hvala [going astray or wrong]
sa:hval -> sa:hvalana = stumbling, staggering
sa:hval -> sa:hvAla = failure
ie:hval ~ sk:chvAliT

ie:hval -> gr:khOlaInO = to make lame, to limp
gr:khOlaInO -> khOleIa = to limp

ie:hval -> lat:claudico/.are = to limp, to be lame
lat:clauditas/.atis = lameness
lat:claudus = limping, lame

ie:hvR {hu+R} [to reach (R) with strong (u) movement (h)] [in a figurative sense"to deceive" or "to cheat"] = to bend, to go wrong, to go the wrong way
ie:hvR -> sa:hvR/hvarati [to go crookedly or astray] [to go wrongly or deviously]
sa:hvR -> sa:haras = crookedness, deceit, intrigue
sa:hvR -> sa:huras = stealthily, deceiving
sa:hvR -> sa:hvAra [going crookedly or deviously] = serpent
sa:hvR -> sa:hvArya = serpentine, winding
ie:hvR -> gr:kyrtOO = to curve, to bend
gr:kyrtOO -> gr:kYptO = to bow down, to bend forward
gr:kyrtOO -> gr:korOnE = curved object, crow
ie:hvR -> lat:curvo/.are = to curve, to bend
lat:curvo -> lat:curvus = bent, bowed, curved
lat:curvus ~ sk:kurva
lat:curvo -> lat:cornix/.icis = crow
lat:curvo -> lat:corvus = raven
lat:curvo -> lat:corona/.ae = garland, circle, crown
lat:curvo -> lat:colubra/.ae = female serpent
lat:curvo -> lat:coluber/.bri = serpent
